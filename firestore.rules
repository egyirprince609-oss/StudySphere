rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner may read their own profile. Client-side writes cannot grant premium access.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.plan == 'free'
        && request.resource.data.premium == false
        && request.resource.data.subscriptionStatus == 'free'
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoURL', 'emailVerified',
          'plan', 'premium', 'subscriptionStatus', 'preferences', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'emailVerified',
          'plan', 'premium', 'subscriptionStatus', 'preferences', 'createdAt', 'updatedAt'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'emailVerified', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // No other collections are accessible until explicit, narrowly scoped rules are added.
  }
}
